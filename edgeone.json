{
  "caches": [
    { "source": "/*.yaml", "cacheTtl": 60},
    { "source": "/*.md", "cacheTtl": 60},
    { "source": "/*.json", "cacheTtl": 60}
  ],
  "headers": [
    {
      "source": "/*.yaml",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*"},
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS"}
      ]
    },
    {
      "source": "/*.md",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*"},
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS"}
      ]
    },
    {
      "source": "/*.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*"},
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS"}
      ]
    }
  ]
}